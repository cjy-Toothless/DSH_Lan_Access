{
  "name": "@local/dsh-lan-access",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 局域网访问插件：在桌面版进程内提供 HTTP/WebSocket 反向代理，手机浏览器可直接使用 DSH Web GUI。",
  "type": "module",
  "main": "src/host/index.js",
  "license": "MIT",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./src/client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "src",
    "locale/*.json",
    "assets/icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
